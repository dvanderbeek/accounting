<div class="container pt-5">
  <h1 class="h2 mb-4">
    Rewards Overview
  </h1>

  <div class="alert alert-light border-start border-primary mb-4">
    <h4 class="alert-heading h5 mb-2">Simulation Buttons</h4>
    <p>These buttons simulate on-chain events that would need to be indexed (or off-chain data that would need to be imported in the case of fee payments). By translating these events into proper accounting journal entries, we maintain a clear audit trail of fund flows and can accurately calculate all the metrics shown in the statements below.</p>
    <p class="mb-0">This demo focuses on Ethereum, but the same architecture can be used for any protocol. We just need to identify the events to track and the proper accounting entries for each.</p>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <h6 class="mb-2">CL Rewards</h6>
      <div class="d-flex flex-column gap-2">
        <%= button_to "Simulate CL Reward", simulate_reward_path(type: "consensus"), method: :post, class: 'btn btn-primary btn-sm' %>
        <%= button_to "Simulate Reward Sweep", simulate_sweep_path, method: :post, class: 'btn btn-primary btn-sm' %>
      </div>
    </div>

    <div class="col-md-4">
      <h6 class="mb-2">EL Rewards</h6>
      <div class="d-flex flex-column gap-2">
        <%= button_to "Simulate EL Reward (transfer)", simulate_reward_path(type: "execution"), method: :post, class: 'btn btn-primary btn-sm' %>
        <%= button_to "Simulate EL Reward (coinbase / self-destruct refund)", simulate_reward_path(type: "execution", coinbase: "true"), method: :post, class: 'btn btn-primary btn-sm' %>
      </div>
    </div>

    <div class="col-md-4">
      <h6 class="mb-2">Fee Payments</h6>
      <div class="d-flex flex-column gap-2">
        <%= button_to "Simulate Off-chain Fee Payment", simulate_fee_payment_path, method: :post, class: 'btn btn-primary btn-sm' %>
        <%= button_to "Trigger OCB Payout", trigger_payout_path, method: :post, class: 'btn btn-primary btn-sm' %>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
      <h3 class="h5 mb-0">Activity</h3>
    </div>

    <div class="card-body">
      <div class="d-flex align-items-center mb-4">
        <i class="fas fa-wallet me-2"></i>
        <h4 class="mb-0">Balance: <%= @org.accounts_by_name.ocb_eth.balance %> ETH</h4>
      </div>

      <div class="row">
        <div class="col-md-4">
          <div class="activity-section">
            <h5 class="border-bottom pb-2 mb-3">
              <i class="fas fa-arrow-down text-success me-2"></i>
              Rewards
            </h5>
            <%= turbo_frame_tag "rewards_timeline" do %>
              <%= render "activity_timeline",
                        items: @rewards,
                        param_name: 'rewards_page',
                        type: :reward %>
            <% end %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="activity-section">
            <h5 class="border-bottom pb-2 mb-3">
              <i class="fas fa-arrow-up text-primary me-2"></i>
              Onchain Billing Payouts
            </h5>
            <%= turbo_frame_tag "payouts_timeline" do %>
              <%= render "activity_timeline",
                        items: @payouts,
                        param_name: 'payouts_page',
                        type: :payout %>
            <% end %>
          </div>
        </div>

        <div class="col-md-4">
          <div class="activity-section">
            <h5 class="border-bottom pb-2 mb-3">
              <i class="fas fa-money-bill text-warning me-2"></i>
              Fee Payments
            </h5>
            <%= turbo_frame_tag "fee_payments_timeline" do %>
              <%= render "activity_timeline",
                        items: @fee_payments,
                        param_name: 'fees_page',
                        type: :fee %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <table class="table table-bordered table-striped shadow-sm rounded bg-white">
    <thead class="thead-light">
      <tr>
        <th colspan="2" class="text-left h4">Rewards Statement</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th colspan="2" class="bg-light">Gross Rewards</th>
      </tr>
      <tr>
        <td class="font-weight-bold">Total Rewards Earned:</td>
        <td><%= @statement.gross_rewards_total %></td>
      </tr>
      <tr>
        <td class="font-weight-bold">Total Rewards Received (total - "unswept / pending"):</td>
        <td><%= @statement.gross_rewards_received %></td>
      </tr>
      <tr>
        <th colspan="2" class="bg-light">Fees</th>
      </tr>
      <tr>
        <td>Fees Paid (For This Period):</td>
        <td><%= @statement.fees_paid %></td>
      </tr>
      <tr>
        <td>- Fees Accrued (For This Period):</td>
        <td><%= @statement.fee_expenses %></td>
      </tr>
      <tr>
        <td>= Overpayment:</td>
        <td><%= @statement.overpayments %></td>
      </tr>
      <tr>
        <td class="pl-4">Reimbursed:</td>
        <td><%= @statement.reimbursements %></td>
      </tr>
      <tr>
        <td class="pl-4">Reimbursements Owed:</td>
        <td><%= @statement.overpayments_owed %></td>
      </tr>
      <tr>
        <th colspan="2" class="bg-light">Net Rewards</th>
      </tr>
      <tr>
        <td>Net Rewards Cash:</td>
        <td><%= @statement.net_rewards_cash %></td>
      </tr>
      <tr>
        <td>Unswept Rewards:</td>
        <td><%= @statement.unswept_rewards %></td>
      </tr>
      <tr>
        <td>Net Rewards Earned:</td>
        <td><%= @statement.net_rewards %></td>
      </tr>
      <tr>
        <th colspan="2" class="bg-light">Balance</th>
      </tr>
      <tr>
        <td>Balance Owed:</td>
        <td><%= @statement.balance %></td>
      </tr>
    </tbody>
  </table>

  <table class="table table-bordered table-striped shadow-sm rounded bg-white">
    <thead class="thead-light">
      <tr>
        <th colspan="2" class="text-left h4">Received Rewards Reconciliation</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Received Rewards</td>
        <td><%= @statement.received_rewards %></td>
      </tr>

      <tr>
        <td>Direct Fee Payments</td>
        <td>- <%= @statement.direct_fee_payments %></td>
      </tr>

      <tr>
        <td>Net Rewards Cash</td>
        <td>= <%= @statement.net_rewards_cash %>  <%= @statement.received_rewards_reconciles? ? '✅' : '❌' %></td>
      </tr>
    </tbody>
  </table>



  <table class="table table-bordered table-striped shadow-sm rounded bg-white">
    <thead class="thead-light">
      <tr>
        <th colspan="2" class="text-left h4">Net Rewards Reconciliation</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Net Rewards Cash</td>
        <td><%= @statement.net_rewards_cash %></td>
      </tr>

      <tr>
        <td>Unswept Rewards</td>
        <td>+ <%= @statement.unswept_rewards %></td>
      </tr>

      <tr>
        <td>OCB Balance</td>
        <td>+ <%= @statement.ocb_balance %></td>
      </tr>

      <tr>
        <td>Balance Owed</td>
        <td>- <%= @statement.balance %></td>
      </tr>

      <tr>
        <td>Net Rewards</td>
        <td>= <%= @statement.net_rewards %> <%= @statement.net_rewards_reconciles? ? '✅' : '❌' %></td>
      </tr>
    </tbody>
  </table>
</div>

<style>
.timeline {
  position: relative;
  max-height: 400px;
  overflow-y: auto;
}

.timeline-item {
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.timeline-item:last-child {
  border-bottom: none;
}

.activity-section {
  height: 100%;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
}

.pagination {
  margin: 0;
}

.pagination a, .pagination span {
  padding: 0.25rem 0.5rem;
  margin: 0 2px;
  border-radius: 3px;
}

.pagination a {
  text-decoration: none;
}
</style>
