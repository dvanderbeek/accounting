<div class="timeline">
  <% items.each do |item| %>
    <div class="timeline-item">
      <div class="timeline-content">
        <div class="d-flex justify-content-between">
          <span class="text-muted"><%= item.date.strftime("%b %d, %Y") %></span>
          <% case type %>
          <% when :reward %>
            <span class="badge <%= reward_badge_class(item) %>">
              <%= item.amount %> ETH
              <%= "(Direct)" if item.paid_to.name == 'rewards' %>
              <%= "(EL)" if item.paid_to.name == 'ocb_eth' %>
              <%= "(CL)" if item.paid_to.name == 'unswept_rewards' %>
              <%= "(coinbase)" if item.coinbase? %>
            </span>
          <% when :payout %>
            <span class="badge bg-primary"><%= item.amount %> ETH</span>
          <% when :fee %>
            <span class="badge bg-warning text-dark">
              <%= item.amount %> ETH
              <%= item.ocb? ? '(ONB)' : '(Direct)' %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="d-flex justify-content-center mt-3">
  <%= will_paginate items,
                    param_name: param_name,
                    class: 'pagination pagination-sm',
                    renderer: TurboPaginationRenderer %>
</div>
